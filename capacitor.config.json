{
  "appId": "com.mukeshmusic4u.app",
  "appName": "Mukesh Music 4u",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0b0f19"
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#0b0f19",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
